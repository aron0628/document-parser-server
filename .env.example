# Required API Keys
UPSTAGE_API_KEY=your_upstage_api_key
OPENAI_API_KEY=your_openai_api_key

# Server
PORT=9997

# RAPTOR
ENABLE_RAPTOR=false
MAX_CHUNKS_FOR_RAPTOR=2000
ENTITY_EXTRACTOR_MAX_CONCURRENCY=3

# Keyword extraction
ENABLE_KEYWORD_EXTRACTION=true

# Docker volume paths (optional)
DATA_VOLUME=./data
RESULT_VOLUME=./result
UPLOADS_VOLUME=./uploads
